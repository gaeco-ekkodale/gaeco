# =============================================================================
# gaeco — local environment (.env.template)
# =============================================================================
# How to start:
#   1. Copy this file:         cp .env.template .env
#   2. Optionally adjust values (registry org + versions at the top usually suffice)
#   3. Start the stack:        docker compose up -d
#
# All values below are working LOCAL defaults. The passwords are
# deliberately simple and intended ONLY for local use — not for production.
# =============================================================================


# #############################################################################
# 0. DOCKER PROJECT NAME
# #############################################################################
# Name of the Docker Compose project. Determines the container/network prefix and
# is shown accordingly in Docker Desktop. Compose reads the variable automatically from
# this .env — as a result all containers are named "gaeco-<service>".
COMPOSE_PROJECT_NAME=gaeco

# #############################################################################
# 1. REGISTRY & IMAGE VERSIONS   ← this is what you bump day to day
# #############################################################################
# Public registry the images are pulled from.
# GitHub Container Registry:   ghcr.io/<org>
# Docker Hub:                  docker.io/<org>   (or just <org>)
IMAGE_REGISTRY=ghcr.io/gaeco-ekkodale

# --- Base services ------------------------------------------------------------
PLUGINHOST_SERVER_TAG=latest
PLUGINHOST_CLIENT_TAG=latest
ORCHESTRATOR_SERVER_TAG=latest
ORCHESTRATOR_CLIENT_TAG=latest
ONTOLOGY_SERVER_TAG=latest
GUIDELINE_SERVER_TAG=latest
INSTANCE_SERVER_TAG=latest
INSTANCE_CLIENT_TAG=latest
ACCESS_SERVER_TAG=latest
ACCESS_CLIENT_TAG=latest
USECASE_SERVER_TAG=latest
USECASE_CLIENT_TAG=latest
PLATFORMCONFIG_CLIENT_TAG=latest
HOMEPAGE_CLIENT_TAG=latest

# --- Add-ons (optional, see docker-compose-files/addons) ----------------------
MAP_SERVER_TAG=latest
MAP_CLIENT_TAG=latest
IFC_UPLOADER_SERVER_TAG=latest
IFC_UPLOADER_CLIENT_TAG=latest
EXCELIMPORT_SERVER_TAG=latest


# #############################################################################
# 2. HOST PORTS   (reachable at localhost:<port>)
# #############################################################################
# Frontends / UIs
PLUGINHOST_CLIENT_PORT=5000        # ← main entry point (Plugin Host UI)
ORCHESTRATOR_CLIENT_PORT=3000
ACCESS_CLIENT_PORT=3132
USECASE_CLIENT_PORT=3131
INSTANCE_CLIENT_PORT=5026
PLATFORMCONFIG_CLIENT_PORT=3133
HOMEPAGE_CLIENT_PORT=3136
MAP_CLIENT_PORT=3135
IFC_CLIENT_PORT=3134

# API-Server
PLUGINHOST_SERVER_PORT=5240
ORCHESTRATOR_SERVER_PORT=6241
ONTOLOGY_SERVER_PORT=5023
GUIDELINE_SERVER_PORT=5008
INSTANCE_SERVER_PORT=5024
ACCESS_SERVER_PORT=5131
USECASE_SERVER_PORT=5130
MAP_SERVER_PORT=5578
IFC_SERVER_PORT=4000
EXCELIMPORT_SERVER_PORT=5241

# Infrastructure
KEYCLOAK_PORT=9345
KAFKA_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ASPIRE_PORT=18888

# Databases (only needed if you want to access the DB from outside)
PLUGINHOST_POSTGRES_PORT=6434
ORCHESTRATOR_POSTGRES_PORT=6433
ONTOLOGY_POSTGRES_PORT=5025
GUIDELINE_POSTGRES_PORT=5027
INSTANCE_POSTGRES_PORT=5814
ACCESS_POSTGRES_PORT=5433
USECASE_POSTGRES_PORT=5511
MAP_POSTGRES_PORT=5469
IFC_POSTGRES_PORT=5432
INSTANCE_ARCADEDB_HTTP_PORT=2480
INSTANCE_ARCADEDB_BINARY_PORT=2424
INSTANCE_ARCADEDB_GREMLIN_PORT=8182


# #############################################################################
# 3. CREDENTIALS   (local defaults — change if needed)
# #############################################################################
# --- Keycloak admin console (http://localhost:9345/admin) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Kafka UI ---
KAFKA_UI_USERNAME=gaeco
KAFKA_UI_PASSWORD=gaeco

# --- Aspire Monitoring Dashboard ---
ASPIRE_TOKEN=aspire-local-token

# --- Postgres per service ---
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=keycloak
KEYCLOAK_POSTGRES_DATABASE=keycloak
PLUGINHOST_POSTGRES_USER=postgres
PLUGINHOST_POSTGRES_PASSWORD=postgres
PLUGINHOST_POSTGRES_DATABASE=pluginhostdb
ORCHESTRATOR_POSTGRES_USER=apporchestratoruser
ORCHESTRATOR_POSTGRES_PASSWORD=AppOrchestratorPassw0rd!
ORCHESTRATOR_POSTGRES_DATABASE=apporchestratordb
ONTOLOGY_POSTGRES_USER=OntologyService
ONTOLOGY_POSTGRES_PASSWORD=ontology-local-pw
ONTOLOGY_POSTGRES_DATABASE=OntologyServiceDB
GUIDELINE_POSTGRES_USER=GuidelineService
GUIDELINE_POSTGRES_PASSWORD=guideline-local-pw
GUIDELINE_POSTGRES_DATABASE=GuidelineServiceDB
INSTANCE_POSTGRES_USER=InstanceService
INSTANCE_POSTGRES_PASSWORD=instance-local-pw
INSTANCE_POSTGRES_DATABASE=InstanceServiceDB
ACCESS_POSTGRES_USER=accessservice
ACCESS_POSTGRES_PASSWORD=access-local-pw
ACCESS_POSTGRES_DATABASE=accessdb
USECASE_POSTGRES_USER=usecase_user
USECASE_POSTGRES_PASSWORD=usecase-local-pw
USECASE_POSTGRES_DB=usecasedb

# --- InstanceService ArcadeDB (Graph) ---
INSTANCE_ARCADEDB_USER=InstanceService
INSTANCE_ARCADEDB_PASSWORD=arcadedb-local-pw
INSTANCE_ARCADEDB_DATABASE=InstanceServiceGremlin

# --- Add-on databases ---
MAP_POSTGRES_USER=mapservice_user
MAP_POSTGRES_PASSWORD=map-local-pw
MAP_POSTGRES_DATABASE=mapservicedb
IFC_DB_USER=ifcuploader
IFC_DB_PASSWORD=ifc-local-pw
IFC_DB_NAME=ifc-uploader-db

# --- App-internal secrets ---
PLUGINHOST_SERVER_GETPLUGIN_SECRET=your-very-secure-and-long-key123!
PLUGINHOST_SNAPSHOT_API_KEY=change-me


# #############################################################################
# 4. KEYCLOAK / AUTHENTICATION
# #############################################################################
KEYCLOAK_REALM=gaeco

# URL under which Keycloak is reachable in the BROWSER = token issuer.
# Used as Keycloak__Authority (expected issuer) and in the clients.
KEYCLOAK_BROWSER_URL=http://localhost:9345
# URL under which the BACKEND containers reach Keycloak (metadata/JWKS fetch).
# Directly via Docker service name + internal port -> platform-independent, no
# detour through the host, no extra_hosts needed. The issuer still remains the
# browser URL above (thanks to KC_HOSTNAME_BACKCHANNEL_DYNAMIC in keycloak.yml).
KEYCLOAK_BACKEND_URL=http://keycloak-server:8080

# --- Client IDs (from the imported realm gaeco-realm.json) ---
KEYCLOAK_PLUGINHOST_CLIENT_CLIENT_ID=plugin-host-client
KEYCLOAK_PLUGINHOST_SERVER_CLIENT_ID=plugin-host-server
KEYCLOAK_PLUGINHOST_SERVER_CLIENT_SECRET=PMDD9BxtquYUohAV33SzcZc1ZijLnKhk

KEYCLOAK_ACCESS_CLIENT_ID=app-access
KEYCLOAK_ACCESS_CLIENT_SECRET=xA2rd7bsPMZVGZhRo9CZhZ0KaUuLh5Ux
KEYCLOAK_INSTANCE_CLIENT_ID=app-instance
KEYCLOAK_INSTANCE_CLIENT_SECRET=F2GcfERBDP7kCMTLQHxGVddCaH9QeODs
KEYCLOAK_ORCHESTRATOR_CLIENT_ID=app-orchestrator

ACCESS_CLIENT_ADMIN_ROLE_NAME=admin

# --- Mount routes of the Microfrontends (in the Plugin Host) ---
ACCESS_MOUNT_ROUTE=/access
USECASE_MOUNT_ROUTE=/usecase
INSTANCE_MOUNT_ROUTE=/instance
PLATFORMCONFIG_MOUNT_ROUTE=/platform-config
HOMEPAGE_MOUNT_ROUTE=/homepage
ORCHESTRATOR_MOUNT_ROUTE=/orchestrator
MAP_MOUNT_ROUTE=/map
IFC_MOUNT_ROUTE=/ifc-uploader


# #############################################################################
# 5. INFRA TUNING   (rarely touched)
# #############################################################################
ASPNETCORE_ENVIRONMENT=Development

# Central storage location for ALL data volumes (Postgres, MinIO, ArcadeDB, ...).
# All data ends up under ONE folder -> easy to back up (copy) or delete.
# The path is resolved relative to docker-compose-files/; "../volumes" thus yields
# the central folder  <repo>/volumes/ . For a backup outside the repo,
# an absolute path is also possible here (e.g. /data/gaeco-volumes or C:/gaeco-data).
VOLUME_BASE_PATH=../volumes

# --- Kafka ---
KAFKA_ADDRESS=gaeco-broker:29092
KAFKA_AUTO_OFFSET_RESET=Earliest
KAFKA_SESSION_TIMEOUT_MS=150000
KAFKA_MAX_POLL_INTERVAL_MS=1500000
KAFKA_MESSAGE_MAX_BYTES=52428800
KAFKA_REPLICA_FETCH_MAX_BYTES=52428800
KAFKA_LOG_RETENTION_MS=-1
KAFKA_LOG_RETENTION_BYTES=-1

# --- Kafka Topics ---
KAFKA_TOPICS_ONTOLOGY=ekkodale.gaeco.ontology.public.uploaded
KAFKA_TOPICS_USECASE=ekkodale.gaeco.usecase.public.usecases
KAFKA_TOPICS_ACCESSRIGHTS=ekkodale.gaeco.access.public.accessrights
KAFKA_TOPICS_USERGROUPS=ekkodale.gaeco.access.public.userGroups
KAFKA_TOPICS_GUIDELINES=ekkodale.gaeco.guideline.public.uploaded
KAFKA_TOPICS_USECASEGUIDELINES=ekkodale.gaeco.access.public.usecaseGuidelines
KAFKA_UPLOADED_GUIDELINE_TOPIC=ekkodale.gaeco.guideline.public.uploaded
KAFKA_TOPIC_PATTERN=^.*\..*\..*\.public\..*\.gaecoImport$
KAFKA_TOPIC_EXCEL=excel-import

# --- Kafka consumer groups ---
KAFKA_CONSUMER_GROUP_ACCESS=accessrights-service-group
KAFKA_CONSUMER_GROUP_INSTANCE=instance-service-group
GUIDELINES_KAFKA_CONSUMER_GROUP=instance-service-guideline-group
GUIDELINES_KAFKA_TOPIC=ekkodale.gaeco.guideline.public.uploaded
ONTOLOGY_KAFKA_CONSUMER_GROUP=instance-service-ontology-group
ONTOLOGY_KAFKA_TOPIC=ekkodale.gaeco.ontology.public.uploaded

# --- MinIO addressing + buckets ---
MINIO_ADDRESS=gaeco-minio:9000
MINIO_ONTOLOGY_BUCKET=ontology
USECASEGUIDELINE_BUCKET_NAME=usecaseguideline

# --- Monitoring (OpenTelemetry -> Aspire) ---
OTLP_ENDPOINT=http://gaeco-monitor-aspire:18889

# --- CORS (Plugin Host UI Origin) ---
ALLOWED_CORS_ORIGIN=http://localhost:5000

# --- Instance Client ---
SHOW_TEXT_THRESHOLD=100

# --- Homepage (start page) ---
# The start page offers a one-click demo-data hint. Local deployment, so on.
# Set to anything other than "true" to hide it entirely.
HOMEPAGE_ENABLE_DEMO_DATA=true


# #############################################################################
# 4b. KEYCLOAK - remaining confidential clients from gaeco-realm.json
# #############################################################################
# Service-account clients of the micro-frontend backends. The secrets below
# are exactly the ones in keycloak/gaeco-realm.json, so the imported realm
# and this file always agree.
KEYCLOAK_USECASE_CLIENT_ID=app-usecase
KEYCLOAK_USECASE_CLIENT_SECRET=TuTUB0wYwM6LPnNaVhN97ubrWvFCeQov
KEYCLOAK_HOMEPAGE_CLIENT_ID=app-homepage
KEYCLOAK_HOMEPAGE_CLIENT_SECRET=g6D1t2Bj4pLRGMR9JPGTCL1iwZUtkZF9
KEYCLOAK_PLATFORMCONFIG_CLIENT_ID=app-platformconfig
KEYCLOAK_PLATFORMCONFIG_CLIENT_SECRET=JX6bNJVwhorzvTSRf0nGVHkxSOSlk8Fi


# #############################################################################
# 5b. DOCKER SOCKET (AppOrchestrator)
# #############################################################################
# The orchestrator starts sibling stacks and therefore needs the docker
# socket. On Docker Desktop / rootful Linux the default below is correct;
# for rootless Docker use /run/user/<uid>/docker.sock.
DOCKER_SOCKET_PATH=/var/run/docker.sock


# #############################################################################
# 6. ADD-ONS: IFC Importer   (docker-compose-files/addons/ifc-parser.yml)
# #############################################################################
# Only IFC_KEYCLOAK_CLIENT_ID / _SECRET are mandatory - the parser mapping
# below merely makes the compose fallbacks visible and editable.
IFC_KEYCLOAK_CLIENT_ID=ifc-parser-server
IFC_KEYCLOAK_CLIENT_SECRET=CREATE_IN_KEYCLOAK_SEE_DOCS
IFC_KAFKA_CONSUMER_GROUP=ifc-uploader-group
IFC_TOPIC_PATTERN_EXPORT=ekkodale.gaeco.instance.public.{usecaseId}.gaecoExport
IFC_TOPIC_PATTERN_IMPORT=ekkodale.gaeco.instance.public.{usecaseId}.gaecoImport
IFC_EXPORT_USECASE_ID=9219ca48-4bf3-46bc-b908-b30d112c66fa
IFC_IMPORT_USECASE_ID=6cae8530-a00b-4514-97c0-7af5d4fb19d2
IFC_KAFKA_USERGROUP=gaeco
IFC_KAFKA_VERSION=v1
IFC_KAFKA_EVENT=dump
IFC_KAFKA_ENTITY=GraphDataModel
IFC_NAMESPACE_URL=https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/
IFC_NAMESPACE_PREFIX=ifc
DCTERMS_NAMESPACE_URL=http://purl.org/dc/terms/
DCTERMS_NAMESPACE_PREFIX=dcterms
IFC_RELATION_NAME=hasPart
IFC_LB_PREFIX_URI=https://example.com/class/
IFC_PORTFOLIO_ID_CLASS_TYPE=https://example.com/class/Portfolio
IFC_BUILDING_ID_CLASS_TYPE=https://example.com/class/Building
IFC_BUILDING_CODE_PROPERTY=BuildingId
IFC_BUILDING_NAME_PROPERTY=Name
IFC_PROJECT_CLASS_TYPE=https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcProject
IFC_BUILDING_TO_PROJECT_PREDICATE=hasIfcProject
BSDD_API_BASE_URL=https://api.bsdd.buildingsmart.org
BSDD_MAPPING_ENABLED=True
BSDD_LANGUAGE_CODE=


# #############################################################################
# 7. ADD-ONS: Map Viewer   (docker-compose-files/addons/map-service.yml)
# #############################################################################
# Guideline class types / property names the map reads its geo data from.
# These must match the ontology actually loaded into your use case.
MAP_KAFKA_CONSUMER_GROUP=map-service-group
MAP_USECASE_ID=6a1c00a8-deec-430c-8808-7a1aad68bc2c
MAP_BUILDING_CLASSTYPE=https://ibpdi.org/ontology/2.0/Building
MAP_ADDRESS_CLASSTYPE=https://ibpdi.org/ontology/2.0/Address
MAP_RELATION_ADDRESSBUILDING=https://ibpdi.org/ontology/2.0/addressHasBuilding
MAP_BUILDING_PROP_NAME=Name
MAP_BUILDING_PROP_DESCRIPTION=Description
MAP_BUILDING_PROP_TYPE=Primary_type
MAP_ADDRESS_PROP_LAT=DeprecatedLatitude
MAP_ADDRESS_PROP_LON=DeprecatedLongitude
