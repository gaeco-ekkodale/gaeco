gaeco:aggregates a owl:ObjectProperty ;
    rdfs:label "aggregates" ;
    rdfs:comment "Derived from EXPRESS relation IfcRelAggregates." ;
    rdfs:domain
        ifc:IfcBuilding,
        ifc:IfcBuildingStorey,
        ifc:IfcProject,
        ifc:IfcSite ;
    rdfs:range
        ifc:IfcBuilding,
        ifc:IfcBuildingStorey,
        ifc:IfcSite,
        ifc:IfcSpace,
        ifc:IfcSpaceBERTH,
        ifc:IfcSpaceEXTERNAL,
        ifc:IfcSpaceGFA,
        ifc:IfcSpaceINTERNAL,
        ifc:IfcSpacePARKING,
        ifc:IfcSpaceSPACE .

gaeco:containsElement a owl:ObjectProperty ;
    rdfs:label "contains element" ;
    rdfs:comment "Derived from EXPRESS relation IfcRelContainedInSpatialStructure." ;
    rdfs:domain
        ifc:IfcBridge,
        ifc:IfcBridgeARCHED,
        ifc:IfcBridgeCABLE_STAYED,
        ifc:IfcBridgeCANTILEVER,
