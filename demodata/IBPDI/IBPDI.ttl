ibpdi:workAreaHasWorkspace a owl:ObjectProperty ;
    rdfs:label "WorkArea has Workspace" ;
    rdfs:comment "Derived from FK column Workspace.WorkAreaId." ;
    rdfs:domain ibpdi:WorkArea ;
    rdfs:range  ibpdi:Workspace .

