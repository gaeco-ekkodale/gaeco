### Direct binary relations (2-column junction tables)

ibpdi:addressHasBuilding a owl:ObjectProperty ;
    rdfs:label "Address has Building" ;
    rdfs:comment "Derived from junction table AddressBuilding." ;
    rdfs:domain ibpdi:Address ;
    rdfs:range  ibpdi:Building .

ibpdi:addressHasContact a owl:ObjectProperty ;
    rdfs:label "Address has Contact" ;
    rdfs:comment "Derived from junction table AddressContact." ;
    rdfs:domain ibpdi:Address ;
    rdfs:range  ibpdi:Contact .

ibpdi:addressHasLand a owl:ObjectProperty ;
    rdfs:label "Address has Land" ;
    rdfs:comment "Derived from junction table AddressLand." ;
    rdfs:domain ibpdi:Address ;
    rdfs:range  ibpdi:Land .

ibpdi:addressHasOrganisation a owl:ObjectProperty ;
    rdfs:label "Address has Organisation" ;
    rdfs:comment "Derived from junction table AddressOrganisation." ;
    rdfs:domain ibpdi:Address ;
    rdfs:range  ibpdi:Organisation .

ibpdi:addressHasRentalUnit a owl:ObjectProperty ;
    rdfs:label "Address has RentalUnit" ;
    rdfs:comment "Derived from junction table AddressRentalUnit." ;
    rdfs:domain ibpdi:Address ;
    rdfs:range  ibpdi:RentalUnit .

ibpdi:addressHasSite a owl:ObjectProperty ;
    rdfs:label "Address has Site" ;
    rdfs:comment "Derived from junction table AddressSite." ;
    rdfs:domain ibpdi:Address ;
    rdfs:range  ibpdi:Site .

